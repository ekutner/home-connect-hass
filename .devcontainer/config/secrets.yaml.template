# Home Connect API credentials.
# Obtain these by registering an application at
#   https://developer.home-connect.com/applications
#
# This file is a TEMPLATE. The real secrets.yaml lives on the host, outside the
# workspace, at ~/.home-connect-dev/secrets.yaml (%USERPROFILE%\.home-connect-dev\
# on Windows) and is symlinked into /config by post-start.sh. Keeping it there
# means it survives deleting the container volume and is never committed.
home_connect_client_id: "YOUR_CLIENT_ID"
home_connect_client_secret: "YOUR_CLIENT_SECRET"
