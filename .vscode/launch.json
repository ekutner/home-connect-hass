{
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
      {
        // Example of attaching to local debug server
        "name": "Home Assistant",
        "type": "debugpy",
        "request": "launch",
        "justMyCode": false,
        "preLaunchTask": "Pre-launch",
        "module": "homeassistant",
        // --skip-pip-packages keeps Home Assistant from installing the
        // home-connect-async wheel from PyPI over the editable install of
        // /workspaces/home-connect-async, which would silently run the
        // published SDK instead of the one being developed here.
        "args": ["--debug", "-c", "/config", "--skip-pip-packages", "home-connect-async"]
      },
      {
        "name": "Tools - Sync Translations",
        "type": "debugpy",
        "request": "launch",
        "justMyCode": true,
        //"module": "tools.sync-translations",
        "args": [],
        "program": "tools/sync-translations.py",

      },
      {
        // Example of attaching to local debug server
        "name": "Python: Attach Local",
        "type": "debugpy",
        "request": "attach",
        "connect": {
            "port": 5678,
            "host": "localhost",
        },
        "pathMappings": [
          {
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "."
          }
        ]
      },
      {
        // Example of attaching to my production server
        "name": "Python: Attach Remote",
        "type": "debugpy",
        "request": "attach",
        "connect": {
            "port": 5678,
            "host": "homeassistant.local",
        },
        "pathMappings": [
          {
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/usr/src/homeassistant"
          }
        ]
      }
    ]
  }
